# Finais de linha corretos em cada sistema, independente de quem fizer o commit.
* text=auto

*.sh       text eol=lf
*.command  text eol=lf
*.py       text eol=lf
*.mako     text eol=lf
*.ps1      text eol=crlf
*.bat      text eol=crlf

*.png      binary
*.ico      binary
*.db       binary

# Fora do ZIP da release (git archive): o que só serve para quem desenvolve.
# O ZIP leva o back-end, a interface já compilada (frontend/dist, copiada pelo workflow),
# os scripts de configuração e de início e os textos para quem usa.
.github             export-ignore
.github/**          export-ignore
.vscode             export-ignore
.vscode/**          export-ignore
.editorconfig       export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
CODE_OF_CONDUCT.md  export-ignore
CONTRIBUTING.md     export-ignore
backend/tests       export-ignore
backend/tests/**    export-ignore
frontend            export-ignore
frontend/**         export-ignore
docs/**             export-ignore
docs/operacao.md    -export-ignore
docs/seguranca.md   -export-ignore
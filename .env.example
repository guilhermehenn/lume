# Configuração local do app. O setup copia este arquivo para .env (que não vai para o Git).
# Depois de mudar algo aqui, feche e abra o app de novo.

# Identificador do app. Também é o nome da pasta de dados.
# Só letras sem acento, números, espaço, ponto, hífen ou sublinhado.
# Atenção: mudar este nome faz o app usar uma pasta de dados NOVA (vazia).
APP_NAME=Lume

# Nome mostrado na tela.
APP_DISPLAY_NAME=Lume

# Porta local. O servidor escuta SOMENTE em 127.0.0.1 (não fica visível na rede).
APP_PORT=8765

# Pasta de dados. Vazio = padrão do sistema:
#   Windows: %LOCALAPPDATA%\Lume
#   macOS:   ~/Library/Application Support/Lume
# O app recusa pastas sincronizadas (OneDrive, iCloud, Dropbox, Google Drive) para o banco.
APP_DATA_DIR=

# Pasta EXTRA que recebe uma cópia de cada backup. Aqui pode ser nuvem ou pendrive,
# por exemplo: C:\Users\voce\OneDrive\Backups-Lume  ou  ~/Library/Mobile Documents/com~apple~CloudDocs/Backups-Lume
# Vazio = desativado.
APP_BACKUP_EXTRA_DIR=

# Retenção dos backups: o último de cada um dos N dias e de cada uma das M semanas.
APP_BACKUP_KEEP_DAILY=7
APP_BACKUP_KEEP_WEEKLY=4

# Abrir o navegador automaticamente ao iniciar (true/false).
APP_OPEN_BROWSER=true

# Nível do log: DEBUG, INFO, WARNING ou ERROR.
APP_LOG_LEVEL=INFO
